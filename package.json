{
  "name": "meridiano",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Laboratório territorial de políticas públicas",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "build": "node scripts/vendor.mjs && node scripts/build.mjs",
    "predev": "node scripts/vendor.mjs",
    "format": "prettier --write dist/*.js dist/*.css dist/index.html api/*.js server/*.js scripts/*.mjs tests/*.js",
    "format:check": "prettier --check dist/*.js dist/*.css dist/index.html api/*.js server/*.js scripts/*.mjs tests/*.js",
    "pretest": "node scripts/vendor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "reicon": "^1.2.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
